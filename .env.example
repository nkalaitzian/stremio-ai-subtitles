# Port and bind address for the addon server
PORT=7000
HOST=0.0.0.0

# Optional: override the OpenSubtitles API base URL (only needed for testing/self-hosting)
# OPENSUBTITLES_BASE=https://api.opensubtitles.com

# Optional: where to keep translation/source caches (defaults to ./.cache)
# CACHE_DIR=.cache
